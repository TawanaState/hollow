{
  "name": "hollow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "server": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts",
    "play": "npm run build && npm run server",
    "logo": "node scripts/make-logo.mjs",
    "icons": "node scripts/make-icons.mjs",
    "train:base": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/train-base.mts",
    "teachers": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/teachers.mts",
    "audio": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/fetch-audio.mts",
    "eval:base": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/eval-personas.mts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
